# Multi-stage Dockerfile for Next.js application
# This creates an optimized production image

# ============================================
# Stage 1: Dependencies
# Install all dependencies needed for build
# ============================================
FROM node:20-alpine AS deps

# Set working directory inside container
WORKDIR /app

# Copy package files first (for better caching)
# Docker caches layers, so if package.json doesn't change, this layer is reused
# Also copy .npmrc for peer dependency configuration
COPY package.json package-lock.json* .npmrc* ./

# Install ALL dependencies (including devDependencies)
# This is needed because Next.js build requires:
# - tailwindcss, postcss, autoprefixer (CSS processing)
# - typescript (type checking during build)
# - eslint (code quality checks)
# Use --legacy-peer-deps to handle ESLint version conflicts
RUN if [ -f package-lock.json ]; then npm ci --legacy-peer-deps; \
    else npm install --legacy-peer-deps; fi

# ============================================
# Stage 2: Builder
# Build the Next.js application
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependencies from previous stage (includes dev dependencies)
COPY --from=deps /app/node_modules ./node_modules

# Copy all source code
COPY . .

# Set environment to production
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build the application
# This creates optimized static files in .next directory
# Build process needs:
# - tailwindcss to process CSS
# - typescript to compile .tsx files
# - postcss for CSS transformations
RUN npm run build

# ============================================
# Stage 3: Runner
# Create minimal production image
# ============================================
FROM node:20-alpine AS runner

WORKDIR /app

# Set to production
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user for security
# Running as root is a security risk
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy only necessary files from builder
# Next.js standalone output includes everything needed to run
# This stage does NOT include devDependencies - only built output
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Copy public directory if it exists (for static assets like images, fonts)
COPY --from=builder --chown=nextjs:nodejs /app/public ./public 2>/dev/null || true

# Switch to non-root user
USER nextjs

# Expose port 3000 (Next.js default)
EXPOSE 3000

# Set hostname to listen on all interfaces
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start the application
# server.js is generated by Next.js standalone build
CMD ["node", "server.js"]
