# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your values

aws_region     = "ap-south-1"  # Mumbai region
aws_account_id = "YOUR_AWS_ACCOUNT_ID"

environment  = "production"
project_name = "portfolio"

# VPC Configuration
vpc_cidr               = "10.0.0.0/16"
availability_zones     = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]
private_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnet_cidrs    = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]
database_subnet_cidrs  = ["10.0.201.0/24", "10.0.202.0/24", "10.0.203.0/24"]

# EKS Configuration
eks_cluster_name    = "portfolio-eks-cluster"
eks_cluster_version = "1.28"

# Node Groups
node_group_general_instance_types = ["t3.medium"]
node_group_general_desired_size   = 2
node_group_general_min_size       = 1
node_group_general_max_size       = 4

node_group_gpu_instance_types = ["g4dn.xlarge"]
node_group_gpu_desired_size   = 1
node_group_gpu_min_size       = 0
node_group_gpu_max_size       = 2

# RDS Configuration
db_instance_class           = "db.t3.micro"
db_engine_version           = "15.4"
db_allocated_storage        = 20
db_name                     = "portfolio"
db_username                 = "dbadmin"
db_backup_retention_period  = 7
enable_db_multi_az          = false  # Set to true for production HA

# ECR Repositories
ecr_repositories = [
  "portfolio-frontend",
  "portfolio-chatbot",
  "llm-log-analyzer"
]
ecr_image_retention_count = 10

# Domain (Optional)
domain_name          = ""  # e.g., "example.com" if you have a domain
create_route53_zone  = false  # Set to true if using Route53

# WAF Configuration
enable_waf      = true
waf_rate_limit  = 2000

# Additional Tags
additional_tags = {
  Team = "DevOps"
  Purpose = "Portfolio"
}
